# ============================================================
# COMPETITIVE INTELLIGENCE AGENT - BACKEND CONFIGURATION
# ============================================================
# Copy this file to .env in backend/ directory for local development.
# DO NOT commit .env or real API keys to version control.

# Application Environment
APP_ENV=development

# Database Configuration
DATABASE_URL=sqlite:///./competitive_intelligence.db

# Hindsight Persistent Memory Configuration
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=YOUR_HINDSIGHT_API_KEY
HINDSIGHT_BANK_ID=competitive-intelligence
HINDSIGHT_TIMEOUT_SECONDS=10.0

# Google Gemini API Configuration (Google AI Studio)
GEMINI_API_KEY=YOUR_GOOGLE_AI_STUDIO_API_KEY
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=15.0
