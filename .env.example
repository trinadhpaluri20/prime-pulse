# ============================================================
# COMPETITIVE INTELLIGENCE AGENT - ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env for local development.
# DO NOT commit .env or real API keys to version control.

# Application Environment & Ports
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Database Configuration
DATABASE_URL=sqlite:///./competitive_intelligence.db

# Hindsight Persistent Memory Configuration
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BANK_ID=competitive-intelligence
HINDSIGHT_TIMEOUT_SECONDS=10.0

# Grok / xAI LLM Provider Configuration (Phase 6)
XAI_API_KEY=your_xai_api_key_here
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-2-latest
XAI_TIMEOUT_SECONDS=15.0

# Legacy LLM Provider Configuration
LLM_PROVIDER=xai
LLM_MODEL=grok-2-latest
LLM_API_KEY=your_xai_api_key_here
