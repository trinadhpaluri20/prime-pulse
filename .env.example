# ============================================================
# COMPETITIVE INTERN - ENVIRONMENT CONFIGURATION
# AI Strategic Intelligence Platform
# ============================================================
# Copy this file to .env for local development.
# DO NOT commit real credentials or .env files to version control.

# Application Ports & Host
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Frontend API URL
VITE_API_URL=http://localhost:8000/api

# Backend Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Configuration
# Format: postgresql://username:password@localhost:5432/database_name
DATABASE_URL=postgresql://username:password@localhost:5432/competitive_intern

# SQLite local fallback (if PostgreSQL is not running locally)
# DATABASE_URL=sqlite:///./competitive_intelligence.db

# AI Intelligence Configuration (Server-Side Only - Never exposed to client)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Historical Memory Configuration (Server-Side Only - Never exposed to client)
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=
HINDSIGHT_BANK_ID=competitive-intelligence
